default_platform(:android)

platform :android do
  desc "Собрать релиз и отправить в Firebase App Distribution"
  lane :distribute do

    # Шаг 1: Автоматическая сборка релизного APK
    gradle(
      task: "assembleRelease"
    )

    # Шаг 2: Загрузка и распространение
    firebase_app_distribution(
      app: "1:731053736871:android:33222e5c1ee1e32ba3ec82",
      service_credentials_file: "firebase_service_account.json",

      # ОБЯЗАТЕЛЬНО замените на реальные email (можно несколько через запятую)
      testers: "samsulinaivilina@gmail.com",

      # Текст, который увидят тестировщики в Firebase
      release_notes: "Новая сборка от #{Time.now.strftime('%d.%m.%Y %H:%M')}"
    )
  end
end